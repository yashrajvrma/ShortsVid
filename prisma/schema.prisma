// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id String @id @default(uuid())

  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  role   Role @default(USER)
  credit Int  @default(0)

  plan SubscriptionPlan @default(FREE)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  scripts  Script[]
  sessions Session[]
  accounts Account[]
  stocks   Stock[]
  videos   Video[]

  subscription    Subscription?
  creditHistories CreditHistory[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum Topic {
  MOTIVATIONAL
  HORROR_STORY
  HISTORY_FACTS
  PHILOSOPHY
  STORYTELLING
  MYSTERY_STORY
  LIFE_HACKS
  ANY_TOPIC
}

enum VideoStyle {
  PHOTO_REALISTIC
  CARTOON
  ANIME
  CYBERPUNK
  CINEMATIC
  PIXEL_ART
  COLORFUL_COMICS
}

enum StockVariant {
  SYSTEM
  USER
}

enum VoiceVariant {
  SYSTEM
  USER
}

enum StockType {
  VOICE
  VIDEO
  IMAGE
  MUSIC
}

enum VoiceService {
  FISH_AUDIO
}

enum Status {
  GENERATING
  READY
  RENDERING
  SUCCESS
  FAILED
}

model Script {
  id String @id @default(cuid())

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  languageCode String   @default("en")
  topic        Topic
  duration     Int
  prompt       String?
  content      String[] // i kept this thinking for faceless as well as conversational videos 

  count Int @default(1) // count the no. of times the script has been generated for the same prompt and block user if the count exceeds a certain limit to prevent abuse

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  video Video?

  @@map("script")
}

model Stock {
  id String @id @default(cuid())

  name        String
  description String?

  stockVariant StockVariant // system or user generated
  stockType    StockType // type of stock (voice, video, image, music)

  mimetype String? // for voice and music
  duration Int? // for voice and video

  r2ObjectKey String?

  userId String? // if user generated, reference to the user
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade) // delete all assets from r2 if user is deleted

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  videos    Video[]  @relation("VideoBackgroundMusic")

  @@map("stock")
}

model Voice {
  id String @id @default(cuid())

  name        String
  description String?
  service     VoiceService // tts service used to generate the voice (e.g. fish audio, elevenlabs, etc.)

  voiceVariant VoiceVariant // system or user generated

  voiceId      String
  modelId      String   @unique
  languageCode String[]
  gender       String

  tags String[] // for filtering voices based on tags like accent, style, etc.

  r2ObjectKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  videos    Video[]  @relation("VideoVoice")

  @@map("voice")
}

model Video {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  videoStyle VideoStyle
  duration   Int? // TODO:update the duration after the audio is generated

  status Status @default(GENERATING)

  scriptId String @unique
  script   Script @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  voiceId String? // TODO : dont make ti optional
  voice   Voice?  @relation("VideoVoice", fields: [voiceId], references: [id], onDelete: SetNull)

  captionConfigId String?        @unique
  captionConfig   CaptionConfig? @relation(fields: [captionConfigId], references: [id], onDelete: SetNull)

  backgroundMusicId String? // bg music id in stock table
  stock             Stock?  @relation("VideoBackgroundMusic", fields: [backgroundMusicId], references: [id], onDelete: SetNull)

  images String[] // array of image r2 object keys
  audio  String? // audio file r2 object key

  caption Json? // caption file in json format (array of objects with text and timestamp)

  thumbnailR2ObjectKey String? // thumbnail image r2 object key
  r2ObjectKey          String? // reference to the video file in r2

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("video")
}

enum TextTransform {
  uppercase
  lowercase
  capitalize
  none
}

enum AnimationPreset {
  pop
  fade
  slide
  none
}

model CaptionConfig {
  id String @id @default(cuid())

  name String?

  textColor            String
  strokeColor          String
  highlightColor       String
  highlightStrokeColor String
  popBackgroundColor   String

  strokeWidth        Float
  fontSize           Float
  verticalPosition   Int
  horizontalPosition Int
  maxLines           Int
  maxWordsPerLine    Int
  shadowOffsetY      Float
  shadowBlur         Float

  fontFamily    String
  fontWeight    String
  textTransform TextTransform
  letterSpacing Float

  animationPreset AnimationPreset

  lightLeakHue  Int
  lightLeakSeed Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  video Video?

  @@map("caption_config")
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
}

enum SubscriptionPeriod {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  CANCELLED
  PAST_DUE
}

model Subscription {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  polarSubscriptionId String @unique
  polarCustomerId     String

  plan   SubscriptionPlan
  period SubscriptionPeriod
  status SubscriptionStatus @default(ACTIVE)

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscription")
}

model CreditHistory {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount        Int // positive = credit added, negative = deducted
  description   String
  balanceBefore Int
  balanceAfter  Int

  videoId             String?
  polarSubscriptionId String?

  createdAt DateTime @default(now())

  @@map("credit_history")
}
